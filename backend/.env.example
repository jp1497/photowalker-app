# Photowalker API - Environment Configuration
# Copy to .env and fill in values.
# See Design/PRD_v2.md - Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=false
API_VERSION=v1

# Database (use postgres service from docker-compose)
DATABASE_URL=postgresql+asyncpg://photowalker:photowalker@localhost:5432/photowalker

# Database pool (optional, defaults in config)
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=3600

# Security (generate a secure key for production)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth - Google (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Storage - AWS S3 (or compatible)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=photowalker-uploads
# Optional: local directory for dev when S3 not configured (e.g. ./local_uploads)
# LOCAL_STORAGE_PATH=./local_uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Redis (optional, for thumbnail queue and scaling)
REDIS_URL=redis://localhost:6379/0
