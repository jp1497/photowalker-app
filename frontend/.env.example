# Photowalker Frontend - Environment Configuration
# Copy to .env.local (Vite loads .env.local)
# Vite exposes env vars prefixed with VITE_

# API base URL (backend). Leave unset in dev to use Vite proxy (recommended for cookies).
# VITE_API_URL=http://localhost:8000

# Google OAuth (same client ID as backend; add http://localhost:5173/auth/callback to Authorized redirect URIs in Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Map: Protomaps Tile API key (required for vector basemap). Free for non-commercial use; see https://protomaps.com/api
VITE_PROTOMAPS_API_KEY=

# E2E tests only: set VITE_E2E_MODE=true and VITE_E2E_SECRET to match backend E2E_TEST_SECRET
# VITE_E2E_MODE=true
# VITE_E2E_SECRET=your-e2e-secret
